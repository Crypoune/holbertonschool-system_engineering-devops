flowchart TD
    User["User"] --> Domain["www.foobar.com"]
    Domain --> DNS["DNS"]
    DNS --> LB["Load balancer (HAProxy)"]

    subgraph Node1["Web/App node 1"]
        Web1["Web server (Nginx)"]
        App1["Application server"]
        Web1 --> App1
    end

    subgraph Node2["Web/App node 2"]
        Web2["Web server (Nginx)"]
        App2["Application server"]
        Web2 --> App2
    end

    LB --> Web1
    LB --> Web2

    App1 --> DBPrimary["Database primary (MySQL)"]
    App2 --> DBPrimary

    DBPrimary -->|replication| DBReplica["Database replica (MySQL)"]

    Web1 --> LB
    Web2 --> LB
    LB --> User
